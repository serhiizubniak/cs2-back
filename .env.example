# Copy to .env and fill in. src/Env.php loads it on every API request and script
# run. Variables already set in the real environment take precedence, so
# production (Render) keeps using the values from its dashboard and needs no
# .env at all. Empty values count as unset.
#
# Comments must sit on their own line — text after a value is part of the value.

# --- Database: Postgres ---
# Connection string. Production: Neon dashboard -> Connect.
# Leave empty to fall back to the PG* variables below (and then to the local
# docker-compose defaults baked into src/Db.php).
DATABASE_URL=postgres://cs2:cs2_local@localhost:5432/cs2_statistics
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

# --- Match parsing: FlareSolverr (Cloudflare bypass for scope.gg) ---
# Without it the parser fetches scope.gg directly, which Cloudflare usually
# blocks. Production: https://neverstay717-flaresolverr-cs2.hf.space/v1
FLARESOLVERR_URL=
# HF token of type "Read" (classic, NOT fine-grained) — the Space is private,
# so FLARESOLVERR_URL is useless without it.
FLARESOLVERR_TOKEN=

# --- Scope Tap browser extension ingest ---
# Shared secret the extension sends in the X-Scope-Tap-Secret header.
# ingest-match answers 500 while this is empty.
SCOPE_TAP_SECRET=

# --- Highlights: metadata from the cs-highlights recorder ---
# Shared secret the recorder sends in the X-Highlights-Token header when it
# publishes a clip. Must equal API_TOKEN in the recorder's .env.
# Generate with:  openssl rand -hex 32
HIGHLIGHTS_API_TOKEN=
# Secret for cleanup-highlights, which deletes every non-favourite clip. Paste it
# into the Admin tab once (the browser remembers it) to use the Cleanup button.
# Kept separate from HIGHLIGHTS_API_TOKEN so the render machine cannot empty the
# bucket.
HIGHLIGHTS_CLEANUP_TOKEN=

# --- Highlights storage: Cloudflare R2 ---
# The recorder uploads clips; the backend only lists the bucket for the Admin
# storage report, deletes clips on Cleanup and builds playable URLs. Point these
# at the same bucket as the recorder's R2_* settings.
#
# Cloudflare dashboard -> R2 Object Storage. The account id is in the sidebar.
R2_ACCOUNT_ID=
# R2 -> API -> Manage API tokens -> Create API token.
# Permission "Object Read & Write", scoped to the bucket below (cleanup needs to
# list and delete). Prefer a token of its own rather than the recorder's.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# S3 API endpoint. Leave empty to derive https://<account_id>.r2.cloudflarestorage.com.
# Local development against MinIO:  http://localhost:9000
R2_ENDPOINT=
# Origin clips are SERVED from (r2.dev subdomain or a custom domain) — the same
# value as the recorder's R2_PUBLIC_BASE_URL. Stored rows keep only the object
# key; the playable URL is built from this on every read, so changing the domain
# does not break existing highlights.
R2_PUBLIC_BASE_URL=
# Storage cap the Admin tab measures usage against, in decimal GB (how Cloudflare
# bills). Keep it equal to the recorder's R2_STORAGE_LIMIT_GB. Empty means 10,
# the free tier; 0 means no cap.
R2_STORAGE_LIMIT_GB=10
